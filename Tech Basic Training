const USERS_SHEET = 'Users';
const RESULTS_SHEET = 'Results';

function doGet() {
  return HtmlService.createTemplateFromFile('index')
    .evaluate()
    .setTitle('Impact Computer Skills Check')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

function getAppBootstrap() {
  const email = getCurrentUserEmail_();
  const user = getUserByEmail_(email);

  return {
    email: email || '',
    firstName: user ? user.first_name : 'there',
    knownUser: !!user,
    scenarios: getScenarioConfig_()
  };
}

function saveResults(payload) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(RESULTS_SHEET);
  if (!sheet) throw new Error('Results sheet not found');

  const row = [
    payload.email || '',
    payload.firstName || '',
    payload.results?.q1_windows_settings || '',
    payload.results?.q2_windows_update_menu || '',
    payload.results?.q3_windows_check_updates || '',
    payload.results?.q4_windows_install_updates || '',
    payload.results?.q5_vantage_system_update || '',
    payload.results?.q6_vantage_check_updates || '',
    payload.results?.q7_vantage_install || '',
    payload.results?.q8_audio_keys || '',
    payload.results?.q9_manual_device_keys || '',
    payload.results?.q10_screenshot || '',
    payload.score || 0,
    new Date(),
    JSON.stringify(payload.details || {})
  ];

  sheet.appendRow(row);
  return { success: true };
}

function getCurrentUserEmail_() {
  try {
    return Session.getActiveUser().getEmail() || '';
  } catch (e) {
    return '';
  }
}

function getUserByEmail_(email) {
  if (!email) return null;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(USERS_SHEET);
  if (!sheet) throw new Error('Users sheet not found');

  const values = sheet.getDataRange().getValues();
  const headers = values.shift();

  const emailIdx = headers.indexOf('email');
  const firstNameIdx = headers.indexOf('first_name');
  const activeIdx = headers.indexOf('active');

  for (const row of values) {
    const rowEmail = String(row[emailIdx] || '').toLowerCase().trim();
    const rowFirstName = String(row[firstNameIdx] || '').trim();
    const rowActive = String(row[activeIdx] || '').toUpperCase().trim();

    if (rowEmail === String(email).toLowerCase().trim() && rowActive === 'TRUE') {
      return {
        email: row[emailIdx],
        first_name: rowFirstName
      };
    }
  }

  return null;
}

